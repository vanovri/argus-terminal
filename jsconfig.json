{
  "compilerOptions": {
    "target": "ES2023",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "public",
    "data"
  ]
}
